PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chayan_db
DB_USER=postgres
DB_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development

# AI Service (required for AI analysis)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=tngtech/deepseek-r1t2-chimera:free
AI_FALLBACK_MODEL=tngtech/deepseek-r1t2-chimera:free
AI_HTTP_REFERER=https://chayan.cornna.xyz
AI_X_TITLE=chayan

# Auth (optional, enables JWT verification when set)
JWT_SECRET=
ADMIN_USER=
ADMIN_PASSWORD_HASH=
JWT_ISSUER=chayan-backend
JWT_AUDIENCE=chayan-frontend
JWT_EXPIRES_IN=24h
AUTH_COOKIE_MAX_AGE_MS=86400000

# Security / CORS
# Comma-separated allowlist, e.g. http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Upload / Python runtime
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_INSERT_BATCH_SIZE=500
PYTHON_OUTPUT_MAX_BYTES=1048576
