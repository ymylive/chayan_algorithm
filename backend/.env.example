PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chayan_db
DB_USER=postgres
DB_PASSWORD=local_dev_db_password_change_me_please
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development

# AI Service (required for AI analysis)
# Primary AI provider (new relay endpoint to fix rate limiting)
AI_API_KEY=sk-dff5b9f31c0e7ae501b74cf57f9d3887964fa6d7cf94e255209ad495611344b0
AI_BASE_URL=https://gmn.chuangzuoli.com/v1/responses
AI_MODEL=gpt-5.2
AI_FALLBACK_MODEL=gpt-5.2
AI_MODEL_FALLBACKS=
AI_PROTOCOL=responses
AI_USE_MOCK=false
AI_RESPONSES_INCLUDE_TEMPERATURE=false
AI_RESPONSES_ENABLE_TOOL_LOOP=false
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=900
AI_REQUEST_TIMEOUT_MS=60000
AI_NARRATIVE_TOTAL_TIMEOUT_MS=150000
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_MS=1000
AI_HTTP_REFERER=https://chayan.cornna.xyz
AI_X_TITLE=chayan
AI_SECONDARY_BASE_URL=https://api-inference.modelscope.cn/v1
AI_SECONDARY_PROTOCOL=openai-completions
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=ZhipuAI/GLM-5
AI_TERTIARY_BASE_URL=https://openrouter.ai/api/v1
AI_TERTIARY_PROTOCOL=openai-completions
AI_TERTIARY_API_KEY=
AI_TERTIARY_MODEL=deepseek/deepseek-r1-0528:free

# MCP aggregated web search controls
AI_MCP_COMPETITOR_VARIANTS=3
AI_MCP_COMPETITOR_RESULT_LIMIT=24
AI_MCP_INDUSTRY_VARIANTS=2
AI_MCP_RESULT_LIMIT=12
MCP_FETCH_TIMEOUT_MS=8000
MCP_WEB_RESULT_LIMIT=10
MCP_WEB_MIN_RESULTS=18
MCP_WEB_MAX_WAVES=3
MCP_WEB_MIN_SOURCES=3
MCP_REMOTE_MCP_TIMEOUT_MS=30000
MCP_RELEVANCE_MIN_SCORE=1.6
MCP_HOST_DIVERSITY_PENALTY=0.12
MCP_HOST_DIVERSITY_WINDOW=12
MCP_ENABLE_WIKIPEDIA_SOURCE=true
MCP_ENABLE_GOOGLE_NEWS_SOURCE=true
MCP_DISABLE_LEGACY_SOURCES=true
# Optional, set to local/remote SearXNG base URL, e.g. http://127.0.0.1:8080
MCP_SEARXNG_BASE_URL=
# Optional, Open-WebSearch MCP HTTP endpoint, e.g. http://127.0.0.1:3000/mcp
MCP_OPEN_WEBSEARCH_MCP_URL=
# Brave removed by default; keep only free/open engines
MCP_OPEN_WEBSEARCH_ENGINES=duckduckgo,bing,baidu,csdn,juejin
# Tavily search API key (free tier supported)
TAVILY_API_KEY=
MCP_TAVILY_SEARCH_DEPTH=basic
# Crawl4AI MCP source, choose HTTP endpoint or local stdio command
MCP_CRAWL4AI_MCP_URL=
MCP_CRAWL4AI_SERVER_COMMAND=
MCP_CRAWL4AI_SERVER_ARGS_JSON=[]
MCP_CRAWL4AI_ENGINE=duckduckgo
# Optional query alias map JSON, e.g. {"茶颜悦色":["cha yan yue se","chayan yuese"]}
MCP_ENTITY_ALIAS_MAP_JSON={}
# Optional, SEC EDGAR MCP HTTP endpoint, e.g. http://127.0.0.1:8765/mcp
MCP_EDGAR_MCP_URL=
MCP_EDGAR_RECENT_FILINGS_LIMIT=12
MCP_TOOL_TIMEOUT_MS=15000
AI_MCP_USE_MOCK_FALLBACK=false
MCP_SERVER_COMMAND=node
MCP_SERVER_PATH=./mcp-server.js

# Data recall controls for ai-analyze
AI_ANALYZE_MATCH_LIMIT=120
AI_ANALYZE_SIGNAL_LIMIT=20
AI_ANALYZE_TOP_INDUSTRY_LIMIT=10
AI_ANALYZE_SAMPLE_LIMIT=20
AI_ANALYZE_MIN_COMPETITOR_COUNT=4
AI_ANALYZE_MIN_COMPETITOR_RELEVANCE=1.8

# Prompt payload limits
AI_PROMPT_TOP_INDUSTRIES_LIMIT=8
AI_PROMPT_RANKING_LIMIT=12
AI_PROMPT_PEERS_LIMIT=12
AI_PROMPT_PEER_RESEARCH_LIMIT=12
AI_PROMPT_MCP_SIGNAL_LIMIT=8
AI_PROMPT_KEY_FINDINGS_LIMIT=8

# Auth (optional, enables JWT verification when set)
JWT_SECRET=
ADMIN_USER=
ADMIN_PASSWORD_HASH=
JWT_ISSUER=chayan-backend
JWT_AUDIENCE=chayan-frontend
JWT_EXPIRES_IN=24h
AUTH_COOKIE_MAX_AGE_MS=86400000

# Security / CORS
# Comma-separated allowlist, e.g. http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Upload / Python runtime
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_INSERT_BATCH_SIZE=500
PYTHON_OUTPUT_MAX_BYTES=1048576
