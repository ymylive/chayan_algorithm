PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chayan_db
DB_USER=postgres
DB_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development

# AI Service (required for AI analysis)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=tngtech/deepseek-r1t2-chimera:free
AI_FALLBACK_MODEL=tngtech/deepseek-r1t2-chimera:free
AI_MODEL_FALLBACKS=
AI_USE_MOCK=false
AI_REQUEST_TIMEOUT_MS=35000
AI_NARRATIVE_TOTAL_TIMEOUT_MS=85000
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_MS=1000
AI_HTTP_REFERER=https://chayan.cornna.xyz
AI_X_TITLE=chayan
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=

# GitHub augmentation for competitor collection (optional)
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_SEARCH_PER_PAGE=10
GITHUB_REQUEST_TIMEOUT_MS=8000
AI_COMPETITOR_MIN_RESULTS=5
AI_COMPETITOR_MAX_RESULTS=12
AI_COMPETITOR_AUGMENT_GITHUB=false
AI_MCP_COMPETITOR_VARIANTS=3
AI_MCP_COMPETITOR_RESULT_LIMIT=24
AI_MCP_INDUSTRY_VARIANTS=2
AI_MCP_RESULT_LIMIT=12
MCP_FETCH_TIMEOUT_MS=8000
MCP_TOOL_TIMEOUT_MS=15000
MCP_SERVER_COMMAND=node
MCP_SERVER_PATH=./mcp-server.js

# Data recall controls for ai-analyze
AI_ANALYZE_MATCH_LIMIT=120
AI_ANALYZE_SIGNAL_LIMIT=20
AI_ANALYZE_TOP_INDUSTRY_LIMIT=10
AI_ANALYZE_SAMPLE_LIMIT=20

# Prompt payload limits
AI_PROMPT_TOP_INDUSTRIES_LIMIT=8
AI_PROMPT_RANKING_LIMIT=12
AI_PROMPT_PEERS_LIMIT=12
AI_PROMPT_PEER_RESEARCH_LIMIT=12
AI_PROMPT_MCP_SIGNAL_LIMIT=20
AI_PROMPT_KEY_FINDINGS_LIMIT=12

# Auth (optional, enables JWT verification when set)
JWT_SECRET=
ADMIN_USER=
ADMIN_PASSWORD_HASH=
JWT_ISSUER=chayan-backend
JWT_AUDIENCE=chayan-frontend
JWT_EXPIRES_IN=24h
AUTH_COOKIE_MAX_AGE_MS=86400000

# Security / CORS
# Comma-separated allowlist, e.g. http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Upload / Python runtime
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_INSERT_BATCH_SIZE=500
PYTHON_OUTPUT_MAX_BYTES=1048576
